# CodeCtx Environment Variables (Template)
# Copy this to .env and fill in your values
# .env is gitignored for security

# Debug mode
CODECTX_DEBUG=false

# Plugin configuration
CODECTX_PLUGINS_ENABLED=true

# Custom output directory (optional)
# CODECTX_OUTPUT_DIR=./output

# API Keys for plugins (if used)
# CODECTX_API_KEY=your_api_key_here

# Custom config directory (optional)
# CODECTX_CONFIG_DIR=/custom/path

# Log level: DEBUG, INFO, WARNING, ERROR
CODECTX_LOG_LEVEL=INFO
